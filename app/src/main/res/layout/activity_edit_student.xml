<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="24dp"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/backArrow"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/arrowleft"
        android:layout_gravity="start"
        android:padding="4dp"
        app:tint="@color/main"
        android:layout_marginStart="10dp"
        android:layout_marginTop="48dp"/>
    <TextView
        android:id="@+id/titleEditStudent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Student"
        android:textSize="28dp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"/>

    <!-- Card View to Group Inputs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/glass_card_bg"
        android:elevation="6dp"
        android:layout_marginBottom="20dp">

        <EditText
            android:id="@+id/editStudentName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Student Name"
            android:drawableStart="@drawable/user"
            android:background="@drawable/edittext_glass_bg"
            android:paddingStart="16dp"
            android:drawablePadding="12dp"
            android:textColor="#6F6969"
            android:textColorHint="#6F6969"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/editStudentId"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Student ID"
            android:drawableStart="@drawable/user"
            android:background="@drawable/edittext_glass_bg"
            android:paddingStart="16dp"
            android:drawablePadding="12dp"
            android:textColor="#6F6969"
            android:textColorHint="#6F6969"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/editStudentEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:drawableStart="@drawable/mail"
            android:drawablePadding="12dp"
            android:background="@drawable/edittext_glass_bg"
            android:paddingStart="16dp"
            android:textColor="#6F6969"
            android:textColorHint="#6F6969"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/editStudentDept"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Department"
            android:drawableStart="@drawable/home"
            android:drawablePadding="12dp"
            android:textColor="#6F6969"
            android:textColorHint="#6F6969"
            android:background="@drawable/edittext_glass_bg"
            android:paddingStart="16dp"/>
    </LinearLayout>

    <!-- Edit Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Edit"
        android:textStyle="bold"
        android:textSize="20dp"
        android:textColor="@android:color/white"
        android:background="@drawable/button_gradient"
        android:layout_marginBottom="16dp"
        app:backgroundTint="@null"/>


</LinearLayout>
