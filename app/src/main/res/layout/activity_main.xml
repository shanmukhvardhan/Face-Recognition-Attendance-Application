<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/gradient_background"
    tools:context=".MainActivity">

    <!-- Admin Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/adminButton"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="40dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/button_gradient"
            android:drawableLeft="@drawable/baseline_lock_24"
            android:padding="15dp"
            android:text="Admin"
            android:textColor="#FFFFFF" />
    </RelativeLayout>

    <!-- Date -->
    <TextView
        android:id="@+id/dateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- Face Scanner Preview (Camera will load here) -->
    <FrameLayout
        android:id="@+id/cameraPreview"
        android:layout_width="300dp"
        android:layout_height="400dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/glass_card_bg"
        android:layout_gravity="center">
        <!-- Live camera preview will load here -->
        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Align Your Face Here"
            android:textColor="#FFFFFF"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Mark Attendance Button -->
    <androidx.appcompat.widget.AppCompatButton

        android:id="@+id/markAttendanceBtn"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Mark Attendance"
        android:layout_marginTop="24dp"
        android:background="@drawable/button_gradient"
        android:textColor="#FFFFFF"
        app:backgroundTint="@null"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tip: Hold phone at eye level in bright lighting."
        android:textAlignment="center"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:textStyle="italic"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"/>

    <!-- Attendance Status Message -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="#00FF00" />
</LinearLayout>
