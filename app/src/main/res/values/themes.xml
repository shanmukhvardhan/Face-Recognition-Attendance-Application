<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.FaceAttendanceApp" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/splash_bg</item>
        <item name="colorSecondary">@color/main</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <style name="CustomTimePickerTheme" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorPrimary">@color/main</item>
        <item name="colorOnSurface">#FFFFFF</item>
    </style>

    <style name="CustomPickerTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/background_dark</item>

        <item name="colorAccent">#4CAF50</item> <item name="android:textColorPrimary">#FFFFFF</item>

        <item name="android:textColorSecondary">#AAAAAA</item>

        <item name="buttonBarPositiveButtonStyle">@style/PickerButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/PickerButtonStyle</item>
    </style>

    <style name="PickerButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- Custom Theme for Date Picker Dialog -->
    <style name="CustomDatePickerTheme" parent="Theme.AppCompat.Light.Dialog">
        <!-- This changes the header background color -->
        <item name="colorAccent">@color/main</item>
        <!-- This forces the OK/Cancel buttons to be a specific color (e.g., Blue) -->
        <item name="android:textColor">@color/main</item>
        <!-- Background of the dialog -->
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- Modern UI Style for Delete Confirmation -->
    <!-- Modern UI Style for Delete Confirmation -->
    <style name="RoundedMaterialDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <!-- Background of the dialog box -->
        <item name="colorSurface">@android:color/darker_gray</item>

        <!-- Button text color (Change #0000FF to your app's primary color) -->
        <item name="colorPrimary">@color/main</item>

        <!-- FIX: Forces the Title Text to be Black -->
        <item name="android:textColorPrimary">#000000</item>

        <!-- FIX: Forces the Message Text to be Dark Gray -->
        <item name="android:textColorSecondary">@color/main</item>

        <!-- Rounded corners -->
        <item name="dialogCornerRadius">28dp</item>
    </style>

</resources>